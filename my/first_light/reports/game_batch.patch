+
+static void game_log_end_line(void) {
+    // Publish only complete lines. A full queue discards the newest line.
+    if(game_log_text("\r\n")) game_log.write=game_log.draft;
+    else game_log.draft=game_log.write;
+}
+
+static void game_log_send(void) {
+    if(game_log.read==game_log.write) return;
+    uint32_t space=(mmio_read(SYSTEM_UART_0_IO_CTRL+4u)>>16)&255u;
+    if(space>GAME_LOG_BYTES_PER_FRAME) space=GAME_LOG_BYTES_PER_FRAME;
+    // The game is the sole UART writer here, so these FIFO slots stay free
+    // until this burst uses them. Never wait for the UART to transmit.
+    while(space && game_log.read!=game_log.write) {
+        mmio_write(SYSTEM_UART_0_IO_CTRL,(uint8_t)game_log.bytes[game_log.read]);
+        game_log.read=(game_log.read+1u)%GAME_LOG_CAPACITY;
+        --space;
+    }
+}
