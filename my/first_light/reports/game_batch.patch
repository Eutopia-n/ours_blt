+
+static int game_log_text(const char *text) {
+    while(*text) {
+        uint32_t next=(game_log.draft+1u)%GAME_LOG_CAPACITY;
+        if(next==game_log.read) return 0;
+        game_log.bytes[game_log.draft]=*text++;
+        game_log.draft=next;
+    }
+    return 1;
+}
